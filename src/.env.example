# MissionGuard AI Environment Configuration
# Copy this file to .env before running locally

# Backend Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
DATABASE_URL=sqlite:///./missionguard.db

# Machine Learning Artifacts
MODEL_DIR=./models_artifacts

# IBM Bob & LLM Integration (Optional external key, defaults to local reasoning engine)
IBM_BOB_API_KEY=dummy-bob-api-key-for-local-demo
IBM_BOB_MODEL_ID=granite-3-8b-instruct
